# =============================================================================
# UbuntuCare Zambia - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="UbuntuCare Zambia"
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME__replace-with-at-least-64-random-characters
UVICORN_WORKERS=4
DEFAULT_CPU_LIMIT=2
DEFAULT_MEM_LIMIT=4G
DEFAULT_CPU_RES=0.5
DEFAULT_MEM_RES=512M

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=ubuntucare
POSTGRES_PASSWORD=CHANGE_ME__postgres
POSTGRES_DB=ubuntucare
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ubuntucare:CHANGE_ME__postgres@localhost:5432/ubuntucare

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Keycloak (Authentication / SSO)
# ─────────────────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME__keycloak-admin
KEYCLOAK_HOSTNAME=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=ubuntucare
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_SECRET=dev-api-gateway-secret-change-me
KEYCLOAK_FRONTEND_CLIENT_ID=frontend

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (S3-compatible Object Storage)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ubuntucare
MINIO_ROOT_PASSWORD=CHANGE_ME__minio-password
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=ubuntucare
MINIO_SECRET_KEY=CHANGE_ME__minio-secret-key

# ─────────────────────────────────────────────────────────────────────────────
# Zambia-Specific Settings
# ─────────────────────────────────────────────────────────────────────────────
ZMW_USD_EXCHANGE_RATE=25.0
ZAMBIA_DEFAULT_PROVINCE=Lusaka
ZAMBIA_DEFAULT_DISTRICT=Lusaka
ZAMBIA_TIMEZONE=Africa/Lusaka
DEFAULT_CURRENCY=ZMW
SMARTCARE_API_URL=https://api.smartcare.zm/v1
SMARTCARE_API_KEY=
NHIMA_API_URL=https://api.nhima.org.zm/v1
NHIMA_API_KEY=
ZAMBIA_NATIONAL_HELPLINE=+260-95-000-0000
ZAMBIA_EMERGENCY_NUMBER=911
ZEPRS_API_URL=https://api.zeprs.gov.zm/v1

# ─────────────────────────────────────────────────────────────────────────────
# Africa's Talking (SMS / Voice / USSD)
# ─────────────────────────────────────────────────────────────────────────────
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=UbuntuCare
AFRICAS_TALKING_PRODUCT_NAME=ubuntucare

# ─────────────────────────────────────────────────────────────────────────────
# Twilio (WhatsApp / SMS fallback)
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─────────────────────────────────────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ubuntucare.zm

# ─────────────────────────────────────────────────────────────────────────────
# Model Endpoints (AI Services)
# ─────────────────────────────────────────────────────────────────────────────
LLM_MODEL_PATH=/data/models/llm/llama-2-7b-chat.Q4_K_M.gguf
LLM_CONTEXT_LENGTH=4096
LLM_N_GPU_LAYERS=35
LLM_N_THREADS=8
LLM_USE_MLOCK=true
LLM_ENDPOINT=http://localhost:8002

# Embedding model
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_DEVICE=cpu

# ─────────────────────────────────────────────────────────────────────────────
# ASR (Speech-to-Text - Whisper)
# ─────────────────────────────────────────────────────────────────────────────
ASR_MODEL_SIZE=medium
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=float32
ASR_LANG=en
ASR_BEAM_SIZE=5
ASR_SERVICE_URL=http://localhost:8003

# ─────────────────────────────────────────────────────────────────────────────
# TTS (Text-to-Speech)
# ─────────────────────────────────────────────────────────────────────────────
TTS_DEVICE=cpu
TTS_SPEAKER_ID=0
TTS_SERVICE_URL=http://localhost:8004

# ─────────────────────────────────────────────────────────────────────────────
# Vector Databases
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_API_KEY=
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=CHANGE_ME__weaviate

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPS=10
RATE_LIMIT_DEFAULT_BURST=20
RATE_LIMIT_REDIS_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring & Observability
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
TELEMETRY_ENABLED=true
OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME__grafana
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME__flower

# ─────────────────────────────────────────────────────────────────────────────
# ELK Stack (Audit Logging)
# ─────────────────────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_ME__elastic
ES_PORT=9200
LOGSTASH_PORT=5000
KIBANA_PORT=5601

# ─────────────────────────────────────────────────────────────────────────────
# Celery (Background Tasks)
# ─────────────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_CONCURRENCY=4
CELERY_QUEUES=default,asr,tts,rag,emr,notifications

# ─────────────────────────────────────────────────────────────────────────────
# Microservice Ports
# ─────────────────────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8000
EMR_PORT=8001
AGENT_PORT=8002
ASR_PORT=8003
TTS_PORT=8004
RAG_PORT=8005

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
FF_TELEMEDICINE_ENABLED=true
FF_AGENT_ORCHESTRATOR_ENABLED=true
FF_ASR_ENABLED=true
FF_TTS_ENABLED=true
FF_RAG_ENABLED=true
FF_DISEASE_SURVEILLANCE=true
FF_COMMUNITY_HEALTH=true
FF_SUPPLY_CHAIN=true
FF_MEDICAL_IMAGING=true
FF_PUBLIC_HEALTH_DASHBOARD=true
FF_RESEARCH_PORTAL=true
FF_OFFLINE_MODE=false
FF_SMARTCARE_SYNC=true
FF_NHIMA_INTEGRATION=true

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
AUDIO_RECORDING_BUCKET=audio-recordings
MEDICAL_IMAGES_BUCKET=medical-images
REPORTS_BUCKET=reports

# ─────────────────────────────────────────────────────────────────────────────
# External Services
# ─────────────────────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Docker Images (SHA digests for security)
# ─────────────────────────────────────────────────────────────────────────────
PGVECTOR_SHA256=latest
REDIS_SHA256=latest
QDRANT_SHA256=latest
WEAVIATE_SHA256=latest
MINIO_SHA256=latest
KEYCLOAK_SHA256=latest
NGINX_SHA256=latest
FLOWER_SHA256=latest
PORTAINER_SHA256=latest
PROMETHEUS_SHA256=latest
GRAFANA_SHA256=latest
ES_SHA256=latest
LOGSTASH_SHA256=latest
KIBANA_SHA256=latest
BASE_IMAGE_TAG=latest
