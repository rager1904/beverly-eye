  "device_detection": {
    "method": "nvidia_smi",
    "fallback_method": "lspci",
    "raspberry_pi_detection": {
      "method": "/proc/device-tree/model",
      "expected_match": "Raspberry Pi 5"
    },
    "jetson_detection": {
      "method": "/etc/nv_tegra_release"
    }
  },
  "model_assignment_rules": {
    "strategy": "best_fit",
    "prioritize_local_inference": true,
    "cpu_fallback_on_gpu_memory_pressure": true,
    "dynamic_offloading": true,
    "offloading_policy": {
      "gpu_utilization_threshold_percent": 85,
      "gpu_memory_threshold_percent": 90,
      "offload_models_in_order": ["vision", "ner", "embedding", "tts", "asr"]
    }
  }
