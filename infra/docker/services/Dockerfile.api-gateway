# =============================================================================

# UbuntuCare - API Gateway (FastAPI)

# Routes: /api/v1/* -> microservices

# =============================================================================

ARG BASE_IMAGE_TAG=latest

FROM python:3.11-slim AS builder



LABEL service="api-gateway"



USER root

COPY infra/docker/services/requirements.service.txt /tmp/requirements.txt

RUN pip install --no-cache-dir -r /tmp/requirements.txt



COPY src/backend/ /app/src/backend/



FROM python:3.11-slim



LABEL service="api-gateway"



USER root

RUN groupadd -g 1000 appuser && useradd -m -u 1000 -g appuser appuser

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

COPY --from=builder /app /app

RUN chown -R appuser:appuser /app



USER appuser

WORKDIR /app



EXPOSE 8000



ENV SERVICE_NAME=api-gateway

ENV PROMETHEUS_MULTIPROC_DIR=/tmp

ENV PYTHONPATH=/app



HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \

    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1



ENTRYPOINT ["python", "-m", "uvicorn", "src.backend.api_gateway.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips", "*"]

