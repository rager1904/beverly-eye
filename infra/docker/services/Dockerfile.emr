# =============================================================================
# UbuntuCare - EMR (Electronic Medical Records) Service
# FHIR-compliant, handles patient records, clinical data
# =============================================================================
ARG BASE_IMAGE_TAG=latest
FROM python:3.11-slim AS builder

LABEL service="emr"

USER root
COPY infra/docker/services/requirements.service.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY src/backend/ /app/src/backend/

FROM python:3.11-slim

LABEL service="emr"

USER root
RUN groupadd -g 1000 appuser && useradd -m -u 1000 -g appuser appuser
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /app /app
RUN chown -R appuser:appuser /app

USER appuser
WORKDIR /app

EXPOSE 8001

ENV SERVICE_NAME=emr
ENV PYTHONPATH=/app

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

ENTRYPOINT ["python", "-m", "uvicorn", "src.backend.services.emr.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2", "--proxy-headers"]
