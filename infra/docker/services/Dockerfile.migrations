FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir "alembic>=1.13.0" "sqlalchemy>=2.0.25" "psycopg[binary]>=3.1"

COPY data/migrations/ /app/data/migrations/
COPY scripts/migration/alembic.ini /app/scripts/migration/alembic.ini

ENV PYTHONPATH=/app

ENTRYPOINT ["alembic", "-c", "/app/scripts/migration/alembic.ini", "upgrade", "head"]
