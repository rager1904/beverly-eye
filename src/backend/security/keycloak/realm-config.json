  "defaultRoles": ["patient"],
  "requiredCredentials": ["password"],
  "otpPolicyType": "totp",
  "authenticationFlows": [
    {
      "alias": "browser with MFA",
      "description": "Browser-based authentication with optional MFA",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 0,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "MFA conditional flow",
          "authenticationExecutions": [
            {
              "authenticator": "condition-user-configured",
              "requirement": "REQUIRED",
              "priority": 0,
              "userSetupAllowed": false,
              "autheticatorFlow": false
            },
            {
              "authenticator": "auth-otp-form",
              "requirement": "REQUIRED",
              "priority": 10,
              "userSetupAllowed": false,
              "autheticatorFlow": false
            }
          ]
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "mfa-conditional",
      "config": {
        "conditionUserConfigured": "required"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],
  "identityProviders": [],
  "identityProviderMappers": [],
  "protocolMappers": [
    {
      "name": "hospital_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "hospital_id",
        "claim.name": "hospital_id",
        "claim.value": "",
        "jsonType.label": "String",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "mfa_enabled",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "mfa_enabled",
        "claim.name": "mfa_enabled",
        "claim.value": "",
        "jsonType.label": "boolean",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "full name",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-full-name-mapper",
      "consentRequired": false,
      "config": {
        "id.token.claim": "true",
        "access.token.claim": "true"
      }
    },
    {
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "consentRequired": false,
      "config": {
        "full.path": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "claim.name": "groups",
        "userinfo.token.claim": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "api-gateway",
      "name": "UbuntuCare API Gateway",
      "description": "Backend API client for UbuntuCare Zambia",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "**********",
      "redirectUris": ["http://localhost:8000/*", "https://api.ubuntucare.zm/*"],
      "webOrigins": ["http://localhost:3000", "https://app.ubuntucare.zm"],
      "publicClient": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300",
        "client.secret.creation.time": "0",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "frontend",
      "name": "UbuntuCare Frontend",
      "description": "React web application frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*", "https://app.ubuntucare.zm/*"],
      "webOrigins": ["http://localhost:3000", "https://app.ubuntucare.zm"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "ubuntucare-mobile",
      "name": "UbuntuCare Mobile",
      "description": "Mobile application for CHWs and field workers",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["ubuntucare://callback", "http://localhost:8081/*"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "roles", "profile", "email", "offline_access"],
      "optionalClientScopes": ["address", "phone"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "User roles and permissions"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "claim.name": "realm_access.roles",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "claim.name": "resource_access.${client_id}.roles",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ny", "bem", "sn"],
  "defaultLocale": "en",
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "event-queue"],
  "enabledEventTypes": [
    "LOGIN", "LOGOUT", "REGISTER", "UPDATE_PROFILE", "UPDATE_PASSWORD",
    "VERIFY_EMAIL", "SEND_VERIFY_EMAIL", "SEND_RESET_PASSWORD",
    "EXECUTE_ACTIONS", "REVOKE_GRANT", "LOGIN_ERROR", "REGISTER_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
