{
  "realm": "ubuntucare",
  "displayName": "UbuntuCare Zambia",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>UbuntuCare Zambia</span></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5) and forceExpiredPasswordChange(90) and passwordExpire(PasswordExpire,365)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": ["FreeOTP", "Google Authenticator", "Microsoft Authenticator"],
  "webAuthnPolicyRpEntityName": "UbuntuCare Zambia",
  "webAuthnPolicySignatureAlgorithms": ["ES256"],
  "webAuthnPolicyRpId": "ubuntucare.zm",
  "webAuthnPolicyAttestationConveyancePreference": "not specified",
  "webAuthnPolicyAuthenticatorAttachment": "platform",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyAcceptableAaguids": [],
  "smtpServer": {
    "host": "localhost",
    "port": 587,
    "from": "noreply@ubuntucare.zm",
    "fromDisplayName": "UbuntuCare Zambia",
    "ssl": false,
    "starttls": true
  },
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionMaxLifespanRememberMe": 604800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionIdleTimeoutRememberMe": 86400,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "offlineSessionMaxLifespan": 5184000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "clientSessionMaxLifespan": 86400,
  "clientOfflineSessionMaxLifespan": 5184000,
  "clientOfflineSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Super administrator with full system access",
        "composite": true,
        "composites": {
          "realm": ["doctor", "nurse", "pharmacist", "lab_technician", "public_health_officer"]
        }
      },
      {
        "name": "doctor",
        "description": "Medical doctor - can access clinical records, prescribe, order tests"
      },
      {
        "name": "nurse",
        "description": "Nurse - can access patient records, administer meds, triage"
      },
      {
        "name": "patient",
        "description": "Patient - can view own health records and appointments"
      },
      {
        "name": "pharmacist",
        "description": "Pharmacist - can dispense medications, manage inventory"
      },
      {
        "name": "lab_technician",
        "description": "Lab technician - can process lab orders and enter results"
      },
      {
        "name": "public_health_officer",
        "description": "Public health officer - disease surveillance and reporting"
      },
      {
        "name": "community_health_worker",
        "description": "Community health worker - household visits and vaccinations"
      },
      {
        "name": "ministry_official",
        "description": "Ministry of Health official - aggregate data access for reporting"
      }
    ],
    "client": {
      "api-gateway": [
        {
          "name": "patient:read",
          "description": "Read patient demographics and PHI"
        },
        {
          "name": "patient:write",
          "description": "Create and update patient records"
        },
        {
          "name": "patient:admin",
          "description": "Full administrative control over patient records"
        },
        {
          "name": "encounter:read",
          "description": "Read clinical encounters"
        },
        {
          "name": "encounter:write",
          "description": "Create and update encounters"
        },
        {
          "name": "clinical_note:read",
          "description": "Read clinical notes"
        },
        {
          "name": "clinical_note:write",
          "description": "Create and update clinical notes"
        },
        {
          "name": "appointment:read",
          "description": "View appointments"
        },
        {
          "name": "appointment:write",
          "description": "Create, update, cancel appointments"
        },
        {
          "name": "lab:read",
          "description": "View lab orders and results"
        },
        {
          "name": "lab:write",
          "description": "Create lab orders and enter results"
        },
        {
          "name": "pharmacy:read",
          "description": "View pharmacy inventory and prescriptions"
        },
        {
          "name": "pharmacy:write",
          "description": "Dispense medications and manage inventory"
        },
        {
          "name": "telemedicine:read",
          "description": "View telemedicine consultations"
        },
        {
          "name": "telemedicine:write",
          "description": "Conduct telemedicine consultations"
        },
        {
          "name": "disease_surveillance:read",
          "description": "View surveillance data"
        },
        {
          "name": "disease_surveillance:write",
          "description": "Report disease cases and outbreaks"
        },
        {
          "name": "community_health:read",
          "description": "View community health data"
        },
        {
          "name": "community_health:write",
          "description": "Record community health visits and interventions"
        },
        {
          "name": "admin:*",
          "description": "Super admin access to all resources"
        },
        {
          "name": "ministry:read",
          "description": "Ministry of Health aggregate data access"
        }
      ]
    }
  },
